# This goes at src/test/resources/application.yml (NOT src/main) — it's what @SpringBootTest
# actually boots against: real H2, not the profile files above.
spring:
  application:
    name: __SERVICE_NAME__
  liquibase:
    change-log: classpath:db/changelog/test/db.changelog-master.yaml
  datasource:
    url: jdbc:h2:mem:testdb
    driverClassName: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: validate
    database-platform: org.hibernate.dialect.H2Dialect

cipher:
  password: 1234567890123456

# @SpringBootTest boots without a profile, so this file (not application-test.yml) is what tests load.
# The middleware datasource must be on for DatasourceConfiguration (@Primary DataSource + transactionManager).
company:
  datasource:
    middleware:
      enabled: true
      url: jdbc:h2:mem:testdb
      driverClassName: org.h2.Driver
      username: sa
      password:
      plainPassword: sa
      startup-validation:
        enabled: false
      pool:
        maximum-pool-size: 5
        minimum-idle: 1
