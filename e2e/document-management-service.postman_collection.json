{
  "info": {
    "_postman_id": "6d0f2c41-9a7e-4b3d-8f15-2c7a9e4d1b63",
    "name": "document-management-service",
    "description": "Local testing of document-management-service (DMS) against an Open Bee TEST environment. Run 00_register once, then 02 (sets v_filing_category_id if empty), set v_metadata to the category's metadata IDs/values, then 03 -> 04 -> 05. Every secured request logs in on its own in its pre-request script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00_register (run once)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Consumer registered (fails harmlessly if it already exists - just use 01_login)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"authType\": \"JWT\",\n    \"consumer\": \"{{v_dms_consumer}}\",\n    \"email\": \"{{v_dms_consumer}}@example.com\",\n    \"consumerPassword\": \"{{v_consumer_password}}\",\n    \"roles\": [\"APP_DOCUMENT_MANAGEMENT_SERVICE_USER\"],\n    \"application\": \"document-management-service\",\n    \"environment\": \"local\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseurl}}:{{document-management-service-port}}/api/auth/register",
          "host": ["{{baseurl}}"],
          "port": "{{document-management-service-port}}",
          "path": ["api", "auth", "register"]
        }
      },
      "response": []
    },
    {
      "name": "01_login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"accessToken is returned\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.accessToken).to.be.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"v_access_token\", jsonData.accessToken);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"consumer\": \"{{v_dms_consumer}}\",\n    \"consumerPassword\": \"{{v_consumer_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseurl}}:{{document-management-service-port}}/api/auth/login",
          "host": ["{{baseurl}}"],
          "port": "{{document-management-service-port}}",
          "path": ["api", "auth", "login"]
        }
      },
      "response": []
    },
    {
      "name": "02_list_filing_categories",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.variables.get(\"baseurl\") + \":\" + pm.variables.get(\"document-management-service-port\") + \"/api/auth/login\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({",
              "            consumer: pm.variables.get(\"v_dms_consumer\"),",
              "            consumerPassword: pm.variables.get(\"v_consumer_password\")",
              "        })",
              "    }",
              "}, function (err, response) {",
              "    if (err || response.code !== 200) {",
              "        console.error(\"DMS login failed:\", err || response.code);",
              "        return;",
              "    }",
              "    pm.collectionVariables.set(\"v_access_token\", response.json().accessToken);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"HTTP status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has the GenericResponse envelope\", function () {",
              "    pm.expect(jsonData).to.have.property(\"responseCode\", \"200\");",
              "    pm.expect(jsonData).to.have.property(\"responseMessage\");",
              "    pm.expect(jsonData.correlationId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "});",
              "",
              "pm.test(\"response.filingCategories is an array\", function () {",
              "    pm.expect(jsonData.response.filingCategories).to.be.an(\"array\");",
              "});",
              "",
              "// Prints each category's metadata definitions to the Postman console (View > Show Postman Console),",
              "// and picks the first category if v_filing_category_id is not set yet.",
              "const categories = (jsonData.response && jsonData.response.filingCategories) || [];",
              "categories.forEach(function (c) {",
              "    console.log(\"category \" + c.id + \" '\" + c.name + \"' path=\" + c.path + \" fileNamePattern=\" + c.fileNamePattern);",
              "    (c.metadata || []).forEach(function (m) {",
              "        console.log(\"    metadata \" + m.id + \" \" + m.name + \" type=\" + m.type + \" mandatory=\" + m.mandatory",
              "            + \" multiple=\" + m.multiple + \" readOnly=\" + m.readOnly",
              "            + (m.listValues ? \" values=\" + m.listValues.map(function (v) { return v.name; }).join(\"|\") : \"\"));",
              "    });",
              "});",
              "if (!pm.collectionVariables.get(\"v_filing_category_id\") && categories.length > 0) {",
              "    pm.collectionVariables.set(\"v_filing_category_id\", categories[0].id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{v_access_token}}", "type": "text" }
        ],
        "url": {
          "raw": "{{baseurl}}:{{document-management-service-port}}/api/v1/dms/filing-categories",
          "host": ["{{baseurl}}"],
          "port": "{{document-management-service-port}}",
          "path": ["api", "v1", "dms", "filing-categories"]
        }
      },
      "response": []
    },
    {
      "name": "03_save_document",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({",
              "    url: pm.variables.get(\"baseurl\") + \":\" + pm.variables.get(\"document-management-service-port\") + \"/api/auth/login\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: {",
              "        mode: \"raw\",",
              "        raw: JSON.stringify({",
              "            consumer: pm.variables.get(\"v_dms_consumer\"),",
              "            consumerPassword: pm.variables.get(\"v_consumer_password\")",
              "        })",
              "    }",
              "}, function (err, response) {",
              "    if (err || response.code !== 200) {",
              "        console.error(\"DMS login failed:\", err || response.code);",
              "        return;",
              "    }",
              "    pm.collectionVariables.set(\"v_access_token\", response.json().accessToken);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"HTTP status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"responseCode is '201' and a correlationId is returned\", function () {",
              "    pm.expect(jsonData).to.have.property(\"responseCode\", \"201\");",
              "    pm.expect(jsonData.correlationId).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
              "});",
              "",
              "pm.test(\"response.documentId is returned\", function () {",
              "    pm.expect(jsonData.response.documentId).to.be.a(\"number\");",
              "    pm.collectionVariables.set(\"v_document_id\", jsonData.response.documentId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{v_access_token}}", "type": "text" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Pick a small SYNTHETIC test file (no real client documents). Max 10 MB."
            },
            {
              "key": "filingCategoryId",
              "value": "{{v_filing_category_id}}",
              "type": "text"
            },
            {
              "key": "metadata",
              "value": "{{v_metadata}}",
              "type": "text",
              "description": "JSON object of metadata ID to value or array, e.g. {\"11900\":\"TEST-001\",\"11888\":[\"1001\",\"102\"]}. No Content-Type needed."
            },
            {
              "key": "overwrite",
              "value": "true",
              "type": "text"
            },
            {
              "key": "fileName",
              "value": "",
              "type": "text",
              "disabled": true,
              "description": "Optional. When omitted, the uploaded file's own name is used."
            },
            {
              "key": "description",
              "value": "",
              "type": "text",
              "disabled": true,
              "description": "Optional. Defaults to the resolved file name."
            }
          ]
        },
        "url": {
          "raw": "{{baseurl}}:{{document-management-service-port}}/api/v1/dms/documents",
          "host": ["{{baseurl}}"],
          "port": "{{document-management-service-port}}",
