<?xml version="1.0" encoding="UTF-8"?>
<PMD xmlns="https://pmd.github.io/pmd-7.x/schema/pmd-ruleset.xsd"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="https://pmd.github.io/pmd-7.x/schema/pmd-ruleset.xsd https://pmd.github.io/pmd-7.x/schema/pmd-ruleset.xsd">

    <description>Al Ramz Code Quality Rules</description>

    <!-- GuardLogStatement: code uses SLF4J {} placeholders; the remaining hits only pass cheap getters. -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="GuardLogStatement"/>
    </rule>
    <!-- Style-opinion rules excluded by team decision (static-analysis-scan 03-11-2026):
         no behavior value, ~1,500 findings of pure churn. -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="LongVariable"/>
        <exclude name="ShortVariable"/>
        <exclude name="OnlyOneReturn"/>
        <exclude name="AtLeastOneConstructor"/>
        <exclude name="CommentDefaultAccessModifier"/>
        <exclude name="FieldNamingConventions"/>
    </rule>
    <!-- Repo logger convention is `log` (Lombok @Slf4j) / `logger`; allow those, enforce the rest. -->
    <rule ref="category/java/codestyle.xml/FieldNamingConventions">
        <properties>
            <property name="exclusions" value="serialVersionUID,serialPersistentFields,log,logger,auditLogger"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml">
        <exclude name="LawOfDemeter"/>
    </rule>
    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/security.xml"/>

</PMD>
