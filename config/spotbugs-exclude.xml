<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://spotbugs.github.io/spotbugs/4.8.3/filter/3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://spotbugs.github.io/spotbugs/4.8.3/filter/3 https://spotbugs.github.io/spotbugs/4.8.3/filter/3.xsd">

    <Match>
        <Class name="~.*\*_.*"/>
    </Match>

    <Match>
        <Class name="~.*Model.*"/>
    </Match>

    <Match>
        <Class name="~.*Api.*"/>
    </Match>

    <Match>
        <Class name="~.*Generated.*"/>
    </Match>

    <!-- EI_EXPOSE_REP*: accepted where exposure is by design (static-analysis-scan 03-11-2026). -->
    <!-- OpenAPI-generated DTOs/interfaces (target/generated-sources), regenerated every build, not editable. -->
    <Match>
        <Or>
            <Package name="com.alramz.model"/>
            <Package name="com.alramz.api"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,NM_CONFUSING,SIC_INNER_SHOULD_BE_STATIC_ANON"/>
    </Match>
    <!-- Spring beans storing constructor-injected collaborators (singletons, shared on purpose). -->
    <Match>
        <Class name="~.*(Repository|RepositoryImpl|Service|ServiceImpl|Client|Provider|Controller|Job|Config|Configuration|Mapper)$"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- @ConfigurationProperties: Spring binds through these accessors; copying breaks binding. -->
    <Match>
        <Class name="~.*Properties(\$.*)?"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
