@baseUrl=http://localhost:8085

### Get a token first by registering + logging in below, then paste it here.
@authToken=

###
GET {{baseUrl}}/api/v1/info

###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "authType": "JWT",
    "consumer": "wealth_management_service_app",
    "email": "wealth-management-service@alramz.ae",
    "consumerPassword": "password123",
    "roles": ["APP_WEALTH_MANAGEMENT_SERVICE_USER"],
    "application": "wealth-management-service",
    "environment": "local"
}

###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "consumer": "wealth_management_service_app",
    "consumerPassword": "password123"
}

###
