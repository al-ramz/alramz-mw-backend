###
GET {{baseUrl}}/api/v1/info

###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "authType": "JWT",
    "consumer": "reporting_management_service_app",
    "email": "reporting-management-service@alramz.ae",
    "consumerPassword": "password123",
    "roles": ["APP_REPORTING_MANAGEMENT_SERVICE_USER"],
    "application": "reporting-management-service",
    "environment": "local"
}

###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "consumer": "reporting_management_service_app",
    "consumerPassword": "password123"
}

### Get Relationship Managers
GET {{baseUrl}}/api/v1/relationship-managers
Content-Type: application/json
Authorization: Bearer {{authToken}}

### Get Commissions By Relationship Manager
POST {{baseUrl}}/api/v1/relationship-managers/commissions
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
    "startDate": "2024-01-01",
    "endDate": "2024-01-03",
    "relationshipManagerCodes": ["5000"]
}

### Get Commissions By Relationship Manager -ve test case
POST {{baseUrl}}/api/v1/relationship-managers/commissions
Content-Type: application/json
Authorization: Bearer {{authToken}}

