### Register the app (run once)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
    "authType": "JWT",
    "consumer": "data_validation_app",
    "email": "data.validation@alramz.ae",
    "consumerPassword": "password123",
    "roles": ["APP_DATA_VALIDATION"],
    "application": "onboarding-service",
    "environment": "local"
}

###

### Login to get JWT token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
    "consumer": "data_validation_app",
    "consumerPassword": "password123"
}

